# IqraSec Academy Environment Configuration Example
# Copy this file to .env.local and fill in the values.

# Public Site Base URL (used for canonical certificate QR verification links)
NEXT_PUBLIC_SITE_URL="https://iqrasecacademy.in"

# Supabase Public Configuration (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Server-Only Configuration (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Sheets Sync & Webhook Secret (Never expose to browser, Google Apps Script source, or frontend)
IQRASEC_CERTIFICATE_WEBHOOK_SECRET="your-certificate-webhook-secret"

# Google Sheets Sync Server-Only Configuration (Never expose to browser)
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_RANGE="Certificates!A:H"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Central Application Form URL (Google Form)
NEXT_PUBLIC_APPLICATION_FORM_URL=""

